    "compilerOptions": {
        "noEmit": false,
        "declaration": false,
        "outDir": "dist",
        "rootDir": "src"
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist"],
    "tsc-alias": {
        "resolveFullPaths": true
    }
}
