{
    "name": "@repo/auth-shared",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "import": "./dist/index.js"
        }
    },
    "main": "./dist/index.js",
    "types": "./src/index.ts",
    "files": [
        "dist",
        "src"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "@repo/typescript-config": "workspace:*",
        "better-auth": "^1.6.25",
        "tsc-alias": "^1.9.1",
        "typescript": "^7.0.2"
    },
    "peerDependencies": {
        "better-auth": "^1.6.25"
    }
}
