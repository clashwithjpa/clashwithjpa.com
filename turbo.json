{
    "$schema": "./node_modules/turbo/schema.json",
    "globalEnv": ["NODE_ENV"],
    "globalPassThroughEnv": ["DEBUG"],
    "tasks": {
        "dev": {
            "cache": false,
            "persistent": true,
            "dependsOn": ["^build"]
        },
        "build": {
            "outputs": ["dist/**", "build/**", ".svelte-kit/**"],
            "dependsOn": ["^build"]
        },
        "typecheck": {
            "dependsOn": ["^build"]
        },
        "lint": {
            "dependsOn": ["^lint"]
        },
        "lint:fix": {
            "dependsOn": ["^lint:fix"],
            "cache": false
        },
        "//#format": {
            "cache": false
        },
        "//#format:check": {}
    }
}
