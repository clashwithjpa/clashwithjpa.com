{
    "name": "clashwithjpa.com",
    "private": true,
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "type": "module",
    "module": "index.ts",
    "scripts": {
        "build": "turbo run build",
        "dev": "turbo run dev",
        "dev:server": "bun --cwd apps/server run dev",
        "dev:web": "bun --cwd apps/web run dev",
        "format": "vp fmt",
        "format:check": "vp fmt --check",
        "lint": "vp lint --disable-nested-config",
        "lint:fix": "vp lint --fix --disable-nested-config",
        "check": "vp check",
        "prepare": "husky"
    },
    "dependencies": {
        "@typescript/native-preview": "^7.0.0-dev.20260707.2"
    },
    "devDependencies": {
        "@commitlint/cli": "^20.5.3",
        "@commitlint/config-conventional": "^20.5.3",
        "@types/bun": "latest",
        "husky": "^9.1.7",
        "turbo": "2.8.17",
        "vite-plus": "0.2.7"
    },
    "peerDependencies": {
        "typescript": "^5.9.3"
    },
    "overrides": {
        "vite": "npm:@voidzero-dev/vite-plus-core@0.2.7"
    },
    "packageManager": "bun@1.3.3"
}
