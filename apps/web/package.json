{
    "name": "web",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "build:cap": "cross-env CAPACITOR=true pnpm run build && pnpm exec cap sync",
        "cap:run:android": "pnpm exec cap run android",
        "cap:run:ios": "pnpm exec cap run ios",
        "cap:sync": "pnpm exec cap sync",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "dev": "vite dev",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "prepare": "svelte-kit sync || echo ''",
        "preview": "vite preview",
        "typecheck": "pnpm run check"
    },
    "dependencies": {
        "@ark-ui/svelte": "^5.22.1",
        "@better-auth/api-key": "^1.6.25",
        "@capacitor/android": "^8.5.0",
        "@capacitor/core": "^8.5.0",
        "@capacitor/ios": "^8.5.0",
        "@cartamd/plugin-anchor": "^2.2.0",
        "@cartamd/plugin-code": "^4.2.0",
        "@cartamd/plugin-emoji": "^4.3.0",
        "@codemirror/autocomplete": "^6.20.3",
        "@codemirror/commands": "^6.10.4",
        "@codemirror/lang-markdown": "^6.5.1",
        "@codemirror/language": "^6.12.4",
        "@codemirror/state": "^6.7.1",
        "@codemirror/view": "^6.43.7",
        "@neodrag/svelte": "3.0.0-next.8",
        "@repo/auth-shared": "workspace:*",
        "@repo/clashofclans-client": "workspace:*",
        "@sentry/sveltekit": "^10.69.0",
        "@tanstack/svelte-query": "^5.90.2",
        "ag-charts-community": "^14.0.2",
        "ag-grid-community": "^36.0.2",
        "better-auth": "^1.6.25",
        "carta-md": "^4.11.2",
        "codemirror": "^6.0.2",
        "emojilib": "^4.0.3",
        "isomorphic-dompurify": "^3.21.0",
        "runed": "^0.37.1",
        "svelte-sonner": "^1.1.1",
        "ua-parser-js": "^2.0.10"
    },
    "devDependencies": {
