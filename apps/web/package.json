        "@sveltejs/kit": "^2.70.2",
        "@sveltejs/vite-plugin-svelte": "^7.2.0",
        "@tailwindcss/forms": "^0.5.11",
        "@tailwindcss/typography": "^0.5.20",
        "@tailwindcss/vite": "^4.3.3",
        "@uiw/codemirror-themes-all": "^4.25.11",
        "clsx": "^2.1.1",
        "cross-env": "^10.1.0",
        "eslint": "^10.8.0",
        "prettier": "^3.9.6",
        "shiki": "^4.4.1",
        "svelte": "^5.56.8",
