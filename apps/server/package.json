{
    "name": "server",
    "type": "module",
    "scripts": {
        "ba:generate": "pnpm dlx auth@latest generate --config ./src/lib/auth/index.ts --output ./src/lib/db/schema/ba-auth.ts --yes && tsx scripts/fix-ba-schema.ts",
        "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && tsc -p tsconfig.migrate.json && tsc-alias -p tsconfig.migrate.json",
        "dataset:build-import-lookup": "tsx scripts/migrations/build-import-lookup.ts",
        "dataset:convert-coc": "tsx scripts/migrations/convert-coc-to-json.ts",
        "dataset:migrate": "tsx scripts/migrations/migrate.ts",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:studio": "drizzle-kit studio",
        "dev": "NODE_ENV=development tsx watch --import ./src/lib/instrument.ts src/index.ts",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "start": "node --import ./dist/lib/instrument.js dist/index.js",
        "typecheck": "tsc --noEmit"
    },
    "prettier": "@repo/prettier-config",
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1105.0",
        "@better-auth/api-key": "^1.6.26",
        "@hono/node-server": "^2.1.0",
        "@hono/standard-validator": "^0.4.0",
        "@repo/auth-shared": "workspace:*",
        "@repo/clashofclans-api": "workspace:*",
        "@scalar/hono-api-reference": "^0.11.12",
        "@sentry/node": "^10.69.0",
        "better-auth": "^1.6.26",
        "csv-parse": "^7.0.2",
        "dotenv": "^17.4.2",
        "drizzle-orm": "^0.45.2",
        "hono": "^4.13.1",
        "hono-openapi": "^1.3.1",
        "hono-rate-limiter": "^0.5.3",
        "ioredis": "^6.0.0",
        "pg": "^8.22.0",
        "rate-limit-redis": "^6.0.1",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@repo/eslint-config": "workspace:*",
        "@repo/prettier-config": "workspace:*",
        "@repo/typescript-config": "workspace:*",
        "@types/node": "^26.1.2",
        "@types/pg": "^8.20.4",
        "discord-api-types": "^0.38.53",
        "drizzle-kit": "^0.31.10",
        "eslint": "^10.8.0",
        "tsc-alias": "^1.9.1",
        "tsx": "^4.23.10",
        "typescript": "^6.0.3"
    },
    "packageManager": "pnpm@11.20.0"
}
